{
  "mcpServers": {
    "gx-env": {
      "args": [
        "gx-env",
        "mcp"
      ],
      "command": "gxhub"
    },
    "mastra": {
      "args": [
        "tsx",
        "./packages/mcp-docs-server/src/stdio.ts"
      ],
      "command": "pnpx",
      "env": {
        "REBUILD_DOCS_ON_START": "true"
      }
    }
  }
}
